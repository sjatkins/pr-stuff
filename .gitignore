# The two source repos are cloned side by side here, each with its own git
# history. They are checked out, not vendored:
#   src/       git@github.com:cabarius/pr.git
#   world/     git@github.com:cabarius/pr-world.git
# Adding them here would create gitlinks to commits that live elsewhere.
/src/
/world/

# Mutable runtime state belonging to neither repo: compiled world data plus
# the live player database. Never commit it -- live/lib/account/ holds the
# player password hashes.
/live/

# Player backups: binary player and account files with password hashes.
# The extracted JSONL in py_json/out/ is what gets committed.
players_*.tar

# graphify: machine-specific interpreter path, rebuildable extraction cache,
# and the dated backups the update step writes
graphify-out/.graphify_python
graphify-out/cache/
graphify-out/20??-??-??/
graphify-out/*.sig

# editor lock files
.#*

# Player and full backups made or restored by the scripts
/Backups/
